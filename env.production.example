# Copy to .env on the production server. Never commit the real .env.
CI_ENVIRONMENT = production

app.baseURL = 'https://example.com/'
app.indexPage = ''
app.defaultLocale = 'id'
app.appTimezone = 'Asia/Jakarta'

# Use a dedicated database user with only the permissions required by this app.
database.default.hostname = '127.0.0.1'
database.default.database = 'eprocurement'
database.default.username = 'eprocurement_app'
database.default.password = 'REPLACE_WITH_SECRET'
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.DBDebug = false
# Enable only after configuring MySQL TLS certificates on the server.
# database.default.encrypt = true

# Optional reverse proxy configuration. Set only to trusted proxy addresses.
# app.proxyIPs = '10.0.0.10'

# Do not enable debug toolbar, verbose errors, or development logging in production.
